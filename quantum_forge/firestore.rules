rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The user's own profile document. Every signed-in user owns exactly one.
    // Fields written here (email, displayName, lastSeen, createdAt) come from
    // `FirebaseAuthService._syncUserProfile`. Rules are field-agnostic — the
    // write either lands on the user's own doc or is rejected outright.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Everything under the user's document inherits the same ownership.
      // Reactions are the only thing here today; adding new subcollections
      // (settings, workspaces, history) requires no rule change.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public reaction-template library: readable by everyone (including guests).
    // Authenticated researchers can create and contribute reaction templates;
    // deletions remain restricted to administrators.
    match /library/{templateId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}