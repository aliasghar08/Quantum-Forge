rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The user's own profile document. Every signed-in user owns exactly one.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public reaction-template library: readable and extensible by everyone.
    // Anyone can contribute and add new reactions without authentication blocks.
    // Deletions remain strictly restricted to administrators.
    match /library/{templateId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Public shared reactions: readable by anyone (including guests).
    // Anyone can generate/save a public share snapshot.
    match /shared_reactions/{shareId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}