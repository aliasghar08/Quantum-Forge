{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "quantom-forge",
          "appId": "1:227207155336:android:5e88f11d1c63967fbd993d",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "quantom-forge",
          "configurations": {
            "android": "1:227207155336:android:5e88f11d1c63967fbd993d",
            "ios": "1:227207155336:ios:b88e726cf5a37253bd993d",
            "macos": "1:227207155336:ios:b88e726cf5a37253bd993d",
            "web": "1:227207155336:web:6e8f49a3a0ac4241bd993d",
            "windows": "1:227207155336:web:a06476d3c580d33cbd993d"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "hosting_dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "/app/@(index.html|flutter_service_worker.js|main.dart.js|flutter.js|flutter_bootstrap.js|version.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/@(robots.txt|sitemap.xml|ads.txt|about.html|contact.html|privacy.html|terms.html|licenses.html|google5e323cc7b5450853.html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "/guides/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "/app/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/data/public_hot_index.json.gz",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Content-Encoding",
            "value": "gzip"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=604800"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/search/**",
        "run": {
          "serviceId": "quantum-forge-search",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/cardiac/**",
        "run": {
          "serviceId": "cardiocath-backend",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/cardio-nephro/**",
        "run": {
          "serviceId": "cardiocath-backend",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/nephro/**",
        "run": {
          "serviceId": "nephrolab-backend",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/neuro/**",
        "run": {
          "serviceId": "neurolab-backend",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/seeder/**",
        "run": {
          "serviceId": "quantum-forge-seeder",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/tx1/**",
        "run": {
          "serviceId": "tx1-fastapi-backend",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/gnn/**",
        "run": {
          "serviceId": "quantom-forge-gnn",
          "region": "us-central1"
        }
      },
      {
        "source": "/app",
        "destination": "/app/index.html"
      },
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/reaction/:slug*",
        "destination": "/app/reaction/:slug*",
        "type": 301
      },
      {
        "source": "/library",
        "destination": "/app/library",
        "type": 301
      },
      {
        "source": "/history",
        "destination": "/app/history",
        "type": 301
      },
      {
        "source": "/editor",
        "destination": "/app/editor",
        "type": 301
      },
      {
        "source": "/analytics",
        "destination": "/app/analytics",
        "type": 301
      },
      {
        "source": "/cardio-cath",
        "destination": "/app/cardio-cath",
        "type": 301
      },
      {
        "source": "/cardiac",
        "destination": "/app/cardio-cath",
        "type": 301
      },
      {
        "source": "/neuro-lab",
        "destination": "/app/neuro-lab",
        "type": 301
      },
      {
        "source": "/neuro",
        "destination": "/app/neuro-lab",
        "type": 301
      },
      {
        "source": "/nephro-lab",
        "destination": "/app/nephro-lab",
        "type": 301
      },
      {
        "source": "/nephro",
        "destination": "/app/nephro-lab",
        "type": 301
      },
      {
        "source": "/pulmo-vent",
        "destination": "/app/pulmo-vent",
        "type": 301
      },
      {
        "source": "/pulmo",
        "destination": "/app/pulmo-vent",
        "type": 301
      },
      {
        "source": "/dental",
        "destination": "/app/dental",
        "type": 301
      },
      {
        "source": "/pharmacogenomics",
        "destination": "/app/pharmacogenomics",
        "type": 301
      },
      {
        "source": "/osce",
        "destination": "/app/osce",
        "type": 301
      },
      {
        "source": "/ddi",
        "destination": "/app/ddi",
        "type": 301
      },
      {
        "source": "/organ-article",
        "destination": "/app/organ-article",
        "type": 301
      }
    ]
  }
}