# ============================================================================
# GFN2-xTB Backend Configuration
# ============================================================================

# Service Port (Default: 8003)
PORT=8003

# Optional API Key for securing the microservice.
# If empty, requests are accepted without authentication.
# If set, clients must provide either header "X-API-Key: <key>" or "Authorization: Bearer <key>".
XTB_API_KEY=

# Default implicit solvent model (vacuum, water, acetone, acetonitrile, dmso, thf, toluene)
DEFAULT_SOLVENT=vacuum
