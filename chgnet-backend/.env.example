# ============================================================================
# CHGNet Backend Configuration
# ============================================================================

# Service Port (Default: 8002)
PORT=8002

# Optional API Key for securing the microservice.
# If empty, requests are accepted without authentication.
# If set, clients must provide either header "X-API-Key: <key>" or "Authorization: Bearer <key>".
CHGNET_API_KEY=

# Materials Project API Key (Optional, for querying crystal reference data)
# Get your API key at: https://next-gen.materialsproject.org/api
MP_API_KEY=
