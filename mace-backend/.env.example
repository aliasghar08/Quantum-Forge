# ============================================================================
# MACE-MP-0 Backend Configuration
# ============================================================================

# Service Port (Default: 8001)
PORT=8001

# Optional API Key for securing the microservice.
# If empty, requests are accepted without authentication.
# If set, clients must provide either header "X-API-Key: <key>" or "Authorization: Bearer <key>".
MACE_API_KEY=

# Hugging Face Access Token
# Required if downloading private checkpoints or higher rate limit downloads.
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Model Size: small, medium, or large (default: medium)
MACE_MODEL_SIZE=medium
